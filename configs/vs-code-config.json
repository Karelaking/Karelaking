  "editor.inlayHints.fontFamily": "Fira Code iScript",
  "editor.codeLensFontSize": 1,
  "editor.fontSize": 24,
  "editor.autoClosingBrackets": "always",
  "editor.autoClosingComments": "always",
  "editor.autoClosingQuotes": "always",
  "gulp.autoDetect": "on",
  "grunt.autoDetect": "on",
  "git.autoStash": true,
